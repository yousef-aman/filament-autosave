{
    "name": "yousefaman/filament-autosave",
    "description": "Automatic saving for Filament Edit Pages with visual status indicator",
    "keywords": ["filament", "autosave", "laravel", "forms", "livewire"],
    "license": "MIT",
    "authors": [
        {
            "name": "Yousef Aman",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^4.0 || ^5.0",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "YousefAman\\FilamentAutosave\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "YousefAman\\FilamentAutosave\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "YousefAman\\FilamentAutosave\\AutosaveServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}

{
    "name": "yousefaman/filament-autosave",
    "description": "Automatic form saving for Filament with a visual status indicator, undo, and drafts",
    "keywords": ["filament", "autosave", "laravel", "forms", "livewire"],
    "license": "MIT",
    "homepage": "https://github.com/yousef-aman/filament-autosave",
    "support": {
        "issues": "https://github.com/yousef-aman/filament-autosave/issues",
        "source": "https://github.com/yousef-aman/filament-autosave"
    },
    "authors": [
        {
            "name": "Yousef Aman",
            "email": "superyousef1999@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^4.0 || ^5.0",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "YousefAman\\FilamentAutosave\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "YousefAman\\FilamentAutosave\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "YousefAman\\FilamentAutosave\\AutosaveServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/pest"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
